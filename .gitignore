# Python
__pycache__/
*.pyc
*.pyo

# PyInstaller build output and cache
# (PyInstaller's default --workpath is ./build, which collides with this
#  project's checked-in build/pyinstaller.spec -- see README.md's build
#  section for the --workpath flag that avoids this)
/dist/
/build/pyinstaller/
/build/*/

# build_all.py's combined output for all three variants -- these are the
# binaries that go to GitHub Releases (see README.md's "Download" section
# and RELEASING.md), never committed directly to the repo.
/dist_builds/

# Inno Setup installer output
/dist_installer/

# Dev-only generated icon intermediates (regenerate via tools/generate_icon.py)
# -- kept out of git since assets/icons/icon.ico and icon_512.png are the
#    checked-in outputs that actually matter; this line is a placeholder in
#    case future tooling drops temp files alongside them.
assets/icons/*.tmp

# App's own runtime state (recreated automatically on first launch)
config/settings.json.bak
